{
  "name": "nosso-clima",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12 <13"
  },
  "workspaces": [
    "apps/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-boundaries.test.mjs",
    "check:delivery": "node scripts/web-vercel-config.test.mjs",
    "test:a11y": "npm run build --workspace @nosso-clima/web && node apps/web/test/a11y.mjs",
    "test:e2e": "npm run build --workspace @nosso-clima/api && tsc -p scripts/tsconfig.vercel-entry.json && npm run build --workspace @nosso-clima/web && node scripts/e2e.test.mjs",
    "test:performance": "npm run build --workspace @nosso-clima/web && node scripts/performance.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:boundaries && npm run check:delivery"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
