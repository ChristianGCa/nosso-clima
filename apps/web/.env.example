# Keep VITE_API_BASE_URL unset: development uses Vite's /api proxy;
# production uses the Vercel rewrite on the web origin.
# Optional separate origin for local development only:
# VITE_API_BASE_URL=http://127.0.0.1:3000
# Responsible party and contact shown in the privacy dialog. Public values (they go into the
# bundle). Required on Vercel builds; unset elsewhere shows "não configurados".
# CONTROLLER_NAME=Seu nome ou apelido
# CONTACT_EMAIL=contato@example.com
